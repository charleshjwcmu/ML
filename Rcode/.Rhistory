EOQ_joint_order <- function(D1,h1,c1,D2,h2,c2,K) {
T_comb = sqrt(2*K/(D1*h1+D2*h2))
cost_per_year = (c1*D1+c2*D2) + 1/2*(D1*h1+D2*h2)*T_comb + K/T_comb
result = data.frame(list(T_comb,cost_per_year))
result = t(result)
rownames(result) = c("cycle_time","cost_all")
return(round(result,5))
}
