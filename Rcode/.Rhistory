ELSP <- function(products) {
utilization = sum(products$D/products$P) # feasible if less than 1
T_lb=sum(products$S)/(1-sum(products$D/products$P))
T_cost = sqrt(2*sum(products$K)/sum((1-products$D/products$P)*products$h*products$D))
T_star = max(T_lb,T_cost)
Q_star = T_star*products$D
T_idle = T_star - sum(Q_star/products$P)
if(T_lb>T_cost) {
T_idle = 0
}
H_star = Q_star*(1-products$D/products$P)
return(list(c("Utilization":utilization, T_lb,T_cost,T_star,T_idle),data.frame(Q_star,H_star)))
}
ELSP(products)
