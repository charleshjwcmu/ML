# Assign 3
EOQ_Analysis <- function(D, K, h, c) {
### Parameters ###
#D: annualized demand
#K: delivery cost
#h: annualized holding cost
#c: unit cost
### Step 1: optimum size ###
Q_star = sqrt(2*D*K/h)
### Step 2: cost ###
holding_cost = h*Q_star/2
ording_cost = D/Q_star*K
total_cost = c*D + holding_cost + ording_cost
### Step 3: other statistics ###
inventory_turns = D/Q_star*2
cycle_time = Q_star/D
result = data.frame(list(Q_star,holding_cost,ording_cost,total_cost,inventory_turns,cycle_time))
result = t(result)
rownames(result) = c("EOQ","cost_holding","cost_ordering","cost_all","inventory_turn","cycle_time")
return(round(result,5))
}
EOQ_Finite_Analysis <- function(D, P, K, h, c) {
### Parameters ###
#D: annualized demand
#K: delivery cost
#h: annualized holding cost
#c: unit cost
### Step 1: optimum size ###
h_ = h*(1-D/P)
Q_star = sqrt(2*D*K/h_)
### Step 2: other statistics ###
cycle_time = Q_star/D
max_inventory_level = Q_star*(1-D/P)
Utilization = D/P
idle_time_per_cycle = (1-Utilization)*cycle_time
### Step 3: cost ###
holding_cost = h*max_inventory_level/2
ording_cost = D/Q_star*K
total_cost = c*D + holding_cost + ording_cost
result = data.frame(list(Q_star,cycle_time,max_inventory_level,Utilization, idle_time_per_cycle,holding_cost,ording_cost,total_cost))
result = t(result)
rownames(result) = c("EOQ","cycle_time","max_inventory","utilization","idle time per cycle","cost_holding","cost_ordering","cost_all")
return(round(result,5))
}
